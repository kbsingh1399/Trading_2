# OMNI headless cloud runtime — environment template.
#   cp .env.example .env && chmod 600 .env
# NEVER commit the populated .env; it is gitignored by convention. Secrets enter
# the container only via env_file / secret manager - zero hardcoded credentials.

# ---- assets & cadence -------------------------------------------------------
OMNI_ASSETS=BTC,ETH,SOL,GOLD
OMNI_CADENCE_SECOND=30              # wake at HH:14:30 / :29:30 / :44:30 / :59:30 UTC
OMNI_LOG_LEVEL=INFO

# ---- execution backend (fail-closed) ---------------------------------------
# Explicit choice: native_mt5 | headless_rest | paper.
# If set, the runtime uses EXACTLY this backend and refuses to start when it
# cannot prove connectivity - it never silently falls back from live money.
# Unset = auto-discovery (native -> cloud -> paper only if OMNI_ALLOW_PAPER=1).
EXECUTION_BACKEND=headless_rest

# Backend A (Windows desktop terminal64.exe IPC - the local machine only)
MT5_ACCOUNT_ID=5064568

# Backend B (cloud gateway - MetaApi-shaped REST, runs on Linux containers)
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_DOMAIN=mt-client-api-v1.metaapi.cloud

# Backend C (deterministic paper matching against factory ticks)
OMNI_ALLOW_PAPER=0                  # 1 permits automatic paper fallback

# ---- risk envelope (production invariants) ----------------------------------
# Hard floor 4,775.00 USD and 41 bps friction are code-enforced, not env-tunable.
OMNI_RISK_MIN_USD=10
OMNI_RISK_MAX_USD=20
OMNI_PAPER=0                        # 1 runs the trader in paper mode

# ---- signed microservice ----------------------------------------------------
OMNI_API_SECRET=                    # HMAC-SHA256; empty = local unsigned mode
OMNI_SERVICE_HOST=0.0.0.0
OMNI_SERVICE_PORT=8080

# ---- optional candle-close LLM reasoning ------------------------------------
# When set, CognitiveEngine consults this OpenAI-compatible endpoint; responses
# are enforced against Terminal/Headless/llm_contract.py (zero hallucination).
OMNI_LLM_ENDPOINT=
OMNI_LLM_MODEL=
OMNI_LLM_API_KEY=
